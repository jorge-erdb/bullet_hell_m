<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bullet Hell</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <canvas id="game"></canvas>

    <!-- Start Screen -->
    <div id="start-screen" class="screen active">
        <h1 class="game-title">BULLET HELL</h1>
        <p class="subtitle">Procedural Dodge Action</p>
        <button id="start-btn" class="btn">Start Game</button>
        <div class="controls-info">
            <p><strong>WASD</strong> — Move</p>
            <p><strong>Mouse</strong> — Aim</p>
            <p><strong>Click</strong> — Shoot</p>
            <p><strong>Space</strong> — Pause</p>
        </div>
    </div>

    <!-- HUD Overlay -->
    <div id="hud" class="hud hidden">
        <div class="hud-left">
            <div class="bar-container">
                <div class="bar-label">HP</div>
                <div class="bar-track">
                    <div id="hp-bar" class="bar bar-health"></div>
                </div>
                <span id="hp-text" class="bar-text">100 / 100</span>
            </div>
            <div class="bar-container">
                <div class="bar-label">XP</div>
                <div class="bar-track">
                    <div id="xp-bar" class="bar bar-xp"></div>
                </div>
                <span id="xp-text" class="bar-text">Lv 1 — 0 / 50</span>
            </div>
            <div id="stats-display" class="stats-display">
                DMG: 10 | SPD: 3.0 | BULLETS: 1
            </div>
        </div>
        <div class="hud-right">
            <canvas id="minimap" width="150" height="150"></canvas>
        </div>
    </div>

    <!-- Level Up Screen -->
    <div id="levelup-screen" class="screen hidden">
        <h2 class="levelup-title">LEVEL UP!</h2>
        <p class="levelup-subtitle">Choose an upgrade</p>
        <div id="upgrade-cards" class="upgrade-cards">
            <!-- Cards injected by JS -->
        </div>
        <button id="confirm-upgrade" class="btn hidden">Confirm</button>
    </div>

    <!-- Game Over Screen -->
    <div id="gameover-screen" class="screen hidden">
        <h2 class="gameover-title">GAME OVER</h2>
        <div class="gameover-stats">
            <p>Level Reached: <span id="go-level">1</span></p>
            <p>Rooms Cleared: <span id="go-rooms">0</span></p>
            <p>Enemies Defeated: <span id="go-enemies">0</span></p>
        </div>
        <button id="restart-btn" class="btn">Restart</button>
    </div>

    <!-- Pause Overlay -->
    <div id="pause-overlay" class="screen hidden">
        <h2 class="pause-title">PAUSED</h2>
        <button id="resume-btn" class="btn">Resume</button>
    </div>

    <script src="js/player.js"></script>
    <script src="js/bullet.js"></script>
    <script src="js/enemy.js"></script>
    <script src="js/map.js"></script>
    <script src="js/ui.js"></script>
    <script src="js/game.js"></script>
    <script src="js/main.js"></script>
</body>
</html>
